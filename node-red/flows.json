        "z": "5fdd50edc02cb839",
        "name": "Calculate Average Time",
        "func": "// Initialize context variables if not already set\nif (!context.previousTimestamp) {\n    context.previousTimestamp = msg.payload.timestamp;\n    context.count = 0;\n    context.sumOfIntervals = 0;\n    return null;  // No calculation on the first run\n}\n\n// Calculate the interval between the current and previous timestamp\nlet currentTimestamp = msg.payload.timestamp;\nlet interval = currentTimestamp - context.previousTimestamp;\n\n// Update the context variables\ncontext.sumOfIntervals += interval;\ncontext.count += 1;\nlet averageInterval = context.sumOfIntervals / context.count;\n\n// Update the previous timestamp to the current one\ncontext.previousTimestamp = currentTimestamp;\n\n// Format the average interval to 2 decimal places\naverageInterval = averageInterval.toFixed(2);\n\n// Clear the original payload and only return the average interval\nmsg.payload = { averageInterval: parseFloat(averageInterval) };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
