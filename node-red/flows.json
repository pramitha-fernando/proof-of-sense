    {
        "id": "0f6c163a948cf118",
        "type": "function",
        "z": "5fdd50edc02cb839",
        "name": "Re-arrange data",
        "func": "var readings = []\n\n// number of readings in one row\nconst n = (msg.payload[0].hz_high - msg.payload[0].hz_low) / msg.payload[0].bin_width;\n\nfor (let column = 0; column < msg.payload.length; column++) {\n\n    // re-arrange data\n    for (let i = 0; i < n; i++) {\n        const data_set = {\n            // split frequency range by bin width and convert to MHz\n            \"frequency\": (msg.payload[column].hz_low + i * msg.payload[column].bin_width) / 1e6,\n            \"power_db\": msg.payload[column].power_db[i]\n        }\n        readings.push(data_set); \n    }\n}\n\nmsg.payload = readings\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 840,
        "y": 100,
        "wires": [
            [
                "16da35ce0da3a1b5"
            ]
        ]
    },
    {
