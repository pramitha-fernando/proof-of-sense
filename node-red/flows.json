        "type": "function",
        "z": "5fdd50edc02cb839",
        "name": "Prepare for Chart",
        "func": "let x = [];\nlet y = [];\n\nfor (let i = 0; i < msg.payload.length; i++) { \n    x.push(msg.payload[i].frequency);\n    y.push(msg.payload[i].power_db);\n}\n\nmsg.payload = [{\n    \"series\": [\"Power in dB\"],\n    \"data\": [y],\n    \"labels\": x\n}];\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
