    {
        "id": "5590c49889079877",
        "type": "function",
        "z": "5fdd50edc02cb839",
        "name": "Display Last 10 Block Size",
        "func": "// Split the input data by newline to get individual JSON objects\nlet lines = msg.payload.split('\\n');\n\n// Initialize an array to store the sizes and indices\nlet data = lines.map(line => {\n    if (line.trim()) { // Ensure to process only non-empty lines\n        // Parse the line as JSON\n        let jsonObject = JSON.parse(line);\n        \n        // Calculate the size in bytes of each line\n        let sizeInKB = Buffer.byteLength(line, 'utf8') / 1024; // Get size in KB\n        let blockNumber = jsonObject.index; // Extract the index\n        \n        return { sizeInKB: sizeInKB, blockNumber: blockNumber };\n    }\n    return null;\n}).filter(item => item !== null); // Filter out any null values\n\n// Get the last 10 entries, or pad with 0 if there are fewer than 10\nlet lastTenData = data.slice(-10);\n\n// If there are fewer than 10 entries, fill the remaining with 0 size and a block number of 0\nwhile (lastTenData.length < 10) {\n    lastTenData.unshift({ sizeInKB: 0, blockNumber: 0 });\n}\n\n// Calculate the running average of the block size\nlet sumOfSizes = lastTenData.reduce((sum, item) => sum + item.sizeInKB, 0);\nlet runningAverage = sumOfSizes / lastTenData.length;\n\nrunningAverage = parseFloat(runningAverage.toFixed(2));\n\n// Prepare the payload for the graph node\nmsg.payload = [{\n    \"series\": [\"Size in KB\"],\n    \"data\": [lastTenData.map(item => item.sizeInKB)],\n    \"labels\": lastTenData.map(item => item.blockNumber)\n}];\n\nmsg.runningAverage = runningAverage;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 640,
        "wires": [
            [
                "ca378cb6e1c7339f",
                "9483b9046ca35e57",
                "0ea4932b96951531"
            ]
        ]
